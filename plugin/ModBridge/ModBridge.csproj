<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.2.8</Version>
    <Author>yomo1024</Author>
    <Name>Mod Bridge</Name>
    <Punchline>网页点一下，mod 直接装进 Penumbra。</Punchline>
    <Description>配合本地「FFXIV XMA Manager」使用：管理器点「安装到游戏」→ 游戏内弹窗确认 → 调 Penumbra IPC 解包装入并启用、触发重绘，mod 立刻生效（并可选写入/绘制预览封面）。
服务只监听 127.0.0.1，带 token 鉴权；用 /modbridge 打开设置窗口查看端口、token 与最近安装记录。</Description>
    <RepoUrl>https://github.com/yomo1024/FFXIV_XMA_Manager</RepoUrl>
    <Tags>mods;penumbra;http;bridge;xma;mod-manager</Tags>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 类型化的 Penumbra IPC 订阅器，直接 new Xxx(pi).Invoke(...) 即可 -->
    <PackageReference Include="Penumbra.Api" Version="5.19.2" />
  </ItemGroup>

</Project>
